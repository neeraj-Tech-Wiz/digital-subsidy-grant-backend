spring.application.name=digital-subsidy-grant-platform

spring.datasource.url=jdbc:postgresql://localhost:5432/subsidy_grant_db
spring.datasource.username=your_username
spring.datasource.password=your_password

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

server.port=8080

jwt.secret=YOUR_BASE64_ENCODED_SECRET_HERE
jwt.expiration=86400000

# Brevo HTTP API Configuration (Transactional email over HTTPS)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@digitalsubsidy.local
BREVO_SENDER_NAME=Digital Subsidy Local